# Vite fingerprints every file in /assets with a content hash, so a changed
# file is a changed URL. That makes them safe to cache permanently.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html keeps the same URL forever and names the hashed bundles, so it
# must be revalidated or visitors keep booting yesterday's build.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
