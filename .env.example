# Neither of these is required for local dev — see the fallback each one
# documents. Set them when they'd otherwise be wrong.

# Points the app at a backend other than the local default. With no .env
# file at all, it talks to http://localhost:4000 — the Brevé server's own
# default port — so `npm run dev` on both projects just works together.
VITE_API_URL=https://your-deployed-api.example.com

# Cosmetic only — one marketing bullet on the Plans card ("___ domain").
# Every *real* short link shown anywhere in the app comes from the
# server's own response, driven by its SHORT_DOMAIN — this only exists so
# that one line of copy doesn't quietly go stale if the domain changes.
VITE_SHORT_DOMAIN=bre.ve
